// Renovate, self-hosted in the d42-infra cluster (docs/runbooks/renovate.md
// there). Fork-only, like publish-fork.yml: leave it out of upstream PRs.
// It covers npm dependencies, the Dockerfile's base images and the GitHub
// Actions in .github/workflows. Minor and patch updates automerge once CI
// passes, grouped into one PR a day; majors and digest bumps are separate
// PRs to review.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', ':dependencyDashboard'],
  timezone: 'Europe/Oslo',
  // Conventional commits, without a scope: this repo's convention is no
  // parentheses in commit prefixes ("chore: update ...").
  semanticCommits: 'enabled',
  semanticCommitScope: null,
  gitAuthor: 'Renovate <renovate@dot42.no>',
  // Renovate merges the PR itself after CI is green, not GitHub's auto-merge
  // (there's no branch protection to make that wait for CI).
  automergeType: 'pr',
  platformAutomerge: false,
  packageRules: [
    {
      description: 'Minor and patch updates: one grouped PR a day, automerged once CI passes',
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'all minor and patch dependencies',
      groupSlug: 'all-minor-patch',
      schedule: ['before 6am'],
      automerge: true,
    },
  ],
}
